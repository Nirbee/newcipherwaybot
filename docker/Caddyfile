# No `tls`/`email` directive on purpose: on the IP-only `:80` site (install without a domain)
# a `tls` directive makes Caddy expect TLS on port 80, so plain-HTTP requests get an empty
# response (NS_ERROR_NET_EMPTY_RESPONSE); an empty `{$ACME_EMAIL}` also breaks the directive.
# With a real {$DOMAIN} Caddy still auto-HTTPS (account email is optional); with :80 it serves
# plain HTTP. Set ACME_EMAIL in .env only affects nothing here — kept for future use.
{$DOMAIN} {
	encode gzip
	# Body cap for the public, pre-auth upload endpoints only (Windows-app API + support
	# screenshots); admin uploads/imports elsewhere keep Caddy's default (unlimited).
	@capped path /api/app/v1/* /api/cabinet/support/photo
	request_body @capped {
		max_size 12MB
	}
	# The web app trusts X-Real-IP only from this proxy (a private peer) — overwrite whatever
	# the client sent with the real peer address, so rate limits can't be dodged by spoofing.
	reverse_proxy web:8080 {
		header_up X-Real-IP {remote_host}
	}
}
